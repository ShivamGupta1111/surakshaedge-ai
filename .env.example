# Copy to .env for local overrides. Never put real secrets in this file.

SURAKSHAEDGE_ENV=development
SURAKSHAEDGE_HOST=127.0.0.1
SURAKSHAEDGE_PORT=8080
SURAKSHAEDGE_DATABASE_PATH=./data/surakshaedge.sqlite3
SURAKSHAEDGE_MODEL_DIR=./models
SURAKSHAEDGE_DATA_DIR=./data
SURAKSHAEDGE_LOG_LEVEL=INFO
SURAKSHAEDGE_OFFLINE_MODE=true
SURAKSHAEDGE_METRICS_ENABLED=true
SURAKSHAEDGE_LAZY_LOAD_MODELS=true
SURAKSHAEDGE_MEMORY_SAFE_MODE=true

# Input limits
SURAKSHAEDGE_MAX_MESSAGE_LENGTH=4000
SURAKSHAEDGE_MAX_URL_LENGTH=2048
SURAKSHAEDGE_MAX_BATCH_SIZE=25
SURAKSHAEDGE_RATE_LIMIT_PER_MINUTE=60

# Retention (days). 0 disables automatic expiry.
SURAKSHAEDGE_RETENTION_DAYS=30

# Auth: disabled by default for localhost. Set enabled=true and provide a SHA-256 hex of the API key.
SURAKSHAEDGE_AUTH_ENABLED=false
SURAKSHAEDGE_API_KEY_SHA256=

# CORS: empty means CORS middleware is not enabled.
SURAKSHAEDGE_CORS_ORIGINS=

# Advisor: local_template | executorch_llama
SURAKSHAEDGE_ADVISOR_BACKEND=local_template
SURAKSHAEDGE_EXECUTORCH_MODEL_PATH=
SURAKSHAEDGE_ADVISOR_TIMEOUT_SECONDS=8
SURAKSHAEDGE_STORE_RAW_CONTENT=false

# Test-only: allow private/loopback URL classification without treating it as SSRF-blocked analysis.
SURAKSHAEDGE_ALLOW_PRIVATE_URL_ANALYSIS=false
